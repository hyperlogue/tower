# Preserve the parent environment using direnv's own trust checks, as in
# captain-miao. Keep machine-specific settings outside the repository.
source_up_secure() {
  eval "$(cd .. && env -uDIRENV_{DIR,FILE,WATCHES,DIFF} direnv export bash)"
}
source_up_secure

watch_file nix/shell.nix
watch_file rust-toolchain.toml
use flake

dotenv_if_exists
